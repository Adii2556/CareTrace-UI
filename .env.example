# Copy to .env and replace the placeholder with a locally generated secret.
DJANGO_SECRET_KEY=replace-with-a-generated-secret
# Select production with --settings=config.settings.production or a process variable.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Asia/Kolkata
